{
  "name": "@pablovsouza/react-window-manager",
  "version": "0.9.2",
  "description": "Composable window manager for React with draggable, resizable windows and scoped keyboard shortcuts.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloVSouza/react-window-manager.git"
  },
  "bugs": {
    "url": "https://github.com/PabloVSouza/react-window-manager/issues"
  },
  "homepage": "https://github.com/PabloVSouza/react-window-manager#readme",
  "keywords": [
    "react",
    "window-manager",
    "desktop-ui",
    "tauri"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:css",
    "build:types": "tsc -p tsconfig.json",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "react-reverse-portal": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
